+      await runAnalysis();
+    } catch {
+      toast.error('Could not remove estimate');
+    } finally {
+      setSavingId(null);
+    }
+  };
+
+  // ---- Chart data -----------------------------------------------------------------------
+  const chart = useMemo(() => {
+    if (!mc || !mc.histogram || mc.histogram.length < 2) return null;
+    const bins = mc.histogram;
+    const width = bins[0].to - bins[0].from;
+    const decimals = width < 0.1 ? 2 : width < 1 ? 1 : 0;
