+                    <th className="text-left font-semibold pb-2">Date</th>
+                    <th className="text-left font-semibold pb-2">PERT (normal approx.)</th>
+                    <th className="text-left font-semibold pb-2">Date</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {mc.confidence.map((c, i) => {
