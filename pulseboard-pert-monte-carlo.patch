+                        <td className="py-2 font-data">{fmtDays(c.days)}</td>
+                        <td className="py-2 font-data">{fmtDate(c.date)}</td>
+                        <td className="py-2 font-data">{p ? fmtDays(p.days) : '—'}</td>
